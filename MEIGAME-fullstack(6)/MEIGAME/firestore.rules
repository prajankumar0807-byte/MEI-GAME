rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role(r) { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == r; }
    function admin() { return role('SUPER_ADMIN'); }
    function staff() { return role('STAFF'); }
    match /users/{uid} { allow read: if signedIn() && (request.auth.uid == uid || admin()); allow write: if admin(); }
    match /roles/{id} { allow read, write: if admin(); }
    match /staffPermissions/{uid} { allow read, write: if admin(); }
    match /quizzes/{id} { allow read: if signedIn(); allow write: if admin() || staff(); match /questions/{qid} { allow read: if signedIn(); allow write: if admin() || staff(); } }
    match /quizSessions/{id} { allow read: if signedIn(); allow write: if admin() || staff(); }
    match /participants/{id} { allow read: if signedIn(); allow create: if signedIn(); allow update: if signedIn(); }
    match /answers/{id} { allow read, write: if false; }
    match /quizResults/{id} { allow read: if signedIn(); allow write: if false; }
    match /activityLogs/{id} { allow read: if admin(); allow write: if false; }
    match /quizSettings/{id} { allow read: if signedIn(); allow write: if admin(); }
  }
}
